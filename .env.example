# ============================================================
# 浏览器端变量（会打包进前端，只能放公开值）
# ============================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ============================================================
# Vercel Functions 服务端变量（禁止使用 VITE_ 前缀）
# ============================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# OpenAI 兼容接口
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# AI 请求超时，单位毫秒。必须小于 vercel.json 中的 maxDuration。
AI_REQUEST_TIMEOUT_MS=105000

# 某些兼容接口不支持 response_format；遇到参数错误时可设置为 false。
AI_JSON_RESPONSE_FORMAT=true
